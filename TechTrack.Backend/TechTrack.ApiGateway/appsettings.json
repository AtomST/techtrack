{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "companies-route": {
        "ClusterId": "organization-cluster",
        "Match": {
          "Path": "/api/companies/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://user-service:8080"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "organization-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://organization-service:8080"
          }
        }
      }
    }
  }
}
